{
  "expo": {
    "name": "黑卡 HEIKA",
    "slug": "heika-android",
    "scheme": "heika",
    "version": "2.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F1"
    },
    "android": {
      "package": "com.heika.community",
      "versionCode": 4,
      "allowBackup": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F6F5F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "./plugins/withHeikaSecureStorage",
      [
        "expo-notifications",
        {
          "defaultChannel": "heika-community",
          "color": "#49665F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 HEIKA 选择图片并发布作品。"
        }
      ]
    ]
  }
}
