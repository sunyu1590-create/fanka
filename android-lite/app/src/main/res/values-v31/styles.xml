<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HeikaLite" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/heika_paper</item>
        <item name="android:statusBarColor">@color/heika_paper</item>
        <item name="android:navigationBarColor">@color/heika_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/heika_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_heika_lite</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="Theme.HeikaLite.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/heika_graphite</item>
        <item name="android:statusBarColor">@color/heika_graphite</item>
        <item name="android:navigationBarColor">@color/heika_graphite</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/heika_graphite</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_heika_lite</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
