<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="heika_icon_background">#050505</color>
    <string name="app_name">黑卡 HEIKA</string>
    <style name="HeikaGlassDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/heika_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/heika_dialog_exit</item>
    </style>
    <style name="Theme.Heika" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0D0F13</item>
        <item name="android:navigationBarColor">#0D0F13</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0D0F13</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Theme.Heika.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0F13</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_heika</item>
        <item name="postSplashScreenTheme">@style/Theme.Heika</item>
    </style>
</resources>