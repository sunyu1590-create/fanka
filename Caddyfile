moonclean.shop {
	encode gzip

	# 安装包由 Caddy 直接托管，不经过 Next 容器：
	# 支持 Range 断点续传，也不占用应用内存。
	handle_path /dl/* {
		root * /srv/dl
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header @apk Content-Disposition "attachment"
		@json path *.json
		header @json Cache-Control "public, max-age=60"
		header @apk Cache-Control "public, max-age=600"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	# Supabase Storage 反向代理：图片统一走本站域名，
	# 避免客户端跨境直连存储节点造成的间歇性加载失败。
	handle /storage/* {
		reverse_proxy https://dnotobyltytpgplfimzo.supabase.co {
			header_up Host dnotobyltytpgplfimzo.supabase.co
			header_down Cache-Control "public, max-age=86400"
		}
	}

	# Supabase Auth 反向代理：登录与 token 刷新同样走本站域名。
	# 手机端不再跨境直连东京认证节点，弱网下也不会卡在 TLS 握手。
	handle /auth/v1/* {
		reverse_proxy https://dnotobyltytpgplfimzo.supabase.co {
			header_up Host dnotobyltytpgplfimzo.supabase.co
		}
	}

	# 数据与实时通道同样兜底反代，避免客户端跨境直连。
	handle /rest/v1/* {
		reverse_proxy https://dnotobyltytpgplfimzo.supabase.co {
			header_up Host dnotobyltytpgplfimzo.supabase.co
		}
	}

	handle /realtime/v1/* {
		reverse_proxy https://dnotobyltytpgplfimzo.supabase.co {
			header_up Host dnotobyltytpgplfimzo.supabase.co
		}
	}

	reverse_proxy app:3000
}

www.moonclean.shop {
	redir https://moonclean.shop{uri} permanent
}
