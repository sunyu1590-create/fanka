# 腾讯云开发 CloudBase（唯一后端，已不再使用 Vercel / Supabase）
TCB_ENV_ID=
# 网关地址，形如 https://<envId>.api.tcloudbasegateway.com
CLOUDBASE_GATEWAY=
# 服务端 API Key（service_role），在云开发平台 / API Key 配置中生成，仅服务端使用
CLOUDBASE_APIKEY=

# 注册与改密需要腾讯云用户管理接口，需配置只授权云开发权限的子账号密钥
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# 认证回跳地址（生产为 https://moonclean.shop）
NEXT_PUBLIC_AUTH_REDIRECT_URL=

# AI 工作台（DeepSeek）密钥保险箱
# AI_SETTINGS_ENCRYPTION_KEY 必须是通过 openssl rand -base64 32 生成的 32 字节 base64
AI_SETTINGS_ENCRYPTION_KEY=
# cloudbase = 存云开发私有 bucket（默认）
AI_SECRET_STORE=cloudbase
AI_SECRET_BUCKET=heika-private
