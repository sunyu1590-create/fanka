# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://moonclean.shop
PUBLIC_BASE_URL=https://moonclean.shop
# Base64 encoding of a random 32-byte AES-256 key; generate a unique value per environment.
# AI 供应商密钥（DeepSeek）以密文存放在 Supabase 的 app_secrets 表，该变量的值只在本机环境里。
AI_SETTINGS_ENCRYPTION_KEY=base64-encoded-32-byte-key
# Generate a distinct random value with at least 32 characters. Used only by the internal AI task worker.
AI_TASK_WORKER_TOKEN=replace-with-a-random-value-of-at-least-32-characters
NEXT_PUBLIC_VIDEO_UPLOAD_BETA=0
