# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_AUTH_REDIRECT_URL=https://moonclean.shop

# Server-only: generate once with `openssl rand -base64 32`; keep stable so
# existing redeem-code HMACs and encrypted exports remain verifiable.
HEIKA_REDEEM_CODE_KEY=replace-with-a-stable-32-byte-base64-secret

# Server-only Vercel Cron authorization secret.
CRON_SECRET=replace-with-a-long-random-secret
